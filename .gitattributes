# Files the tests read (include_str! or fs): LF on every checkout, Windows included, so every
# platform's tests read the same bytes. CRLF in boards and lawhrc has tests of its own.
*.lawh text eol=lf
*.snap text eol=lf
*.demo text eol=lf
examples/lawhrc text eol=lf
*.ttf binary
*.otf binary
*.png binary
# release.yml joins cargo-about's output (from about.hbs) and the embedded notices into
# THIRD-PARTY-LICENSES.txt: LF on every runner, Windows included, so the file has one line ending.
about.hbs text eol=lf
about.toml text eol=lf
assets/licenses/*.txt text eol=lf
